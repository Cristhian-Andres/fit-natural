{
  "name": "fit-natural",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:studio": "dotenv -e .env.local -- prisma studio"
  },
  "prisma": {
    "seed": "dotenv -e .env.local -- tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@prisma/client": "^5.14.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.119.2",
    "@vercel/functions": "^3.11.3",
    "@vercel/schedules": "^0.0.3",
    "autoprefixer": "^10.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "recharts": "^3.11.1",
    "sharp": "^0.35.5",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "postcss": "^8.5.33",
    "prisma": "^5.14.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.15.7",
    "typescript": "^5"
  },
  "overrides": {
    "@vercel/oidc": "^4.0.9"
  }
}
